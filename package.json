{
  "name": "mathrl-visual-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "bash scripts/build-site.sh",
    "check": "bash scripts/check.sh",
    "content:check": "node scripts/check-locale-parity.mjs",
    "dev": "corepack pnpm --filter @mathrl/site dev",
    "site:build": "corepack pnpm --filter @mathrl/site build",
    "site:test": "corepack pnpm --filter @mathrl/site test",
    "site:test:e2e": "corepack pnpm --filter @mathrl/site test:e2e",
    "site:typecheck": "corepack pnpm --filter @mathrl/site typecheck",
    "wasm:build": "bash scripts/build-wasm.sh"
  }
}
